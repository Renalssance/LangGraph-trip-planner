
# LLM配置 (从LangGraph继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID="deepseek-chat"

# API密钥
LLM_API_KEY=your key

# 服务地址
LLM_BASE_URL=https://api.deepseek.com/v1

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 思考模式处理:
# - preserve: 保留并回传 reasoning_content（推荐用于 MiMo/DeepSeek 工具调用）
# - deepseek-disabled: 发送 extra_body={"thinking":{"type":"disabled"}}
# - qwen-disabled: 发送 extra_body={"enable_thinking":false}
LLM_THINKING_MODE=preserve

# 是否记录每次 LLM 返回内容到后端日志（调试用，可能包含敏感信息）
LLM_LOG_RESPONSES=false
LLM_LOG_RESPONSE_MAX_CHARS=6000
LLM_LOG_DIR=logs/llm

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Unsplash API Credentials
UNSPLASH_ACCESS_KEY=your key
UNSPLASH_SECRET_KEY=your key

# 高德地图API配置
AMAP_API_KEY=your key
